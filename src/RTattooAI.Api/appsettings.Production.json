{
  // Los valores secretos (ConnectionStrings:Default, Jwt:Key, Blob:ConnectionString)
  // NO van en este archivo: se inyectan como variables de entorno en el hosting
  // (p. ej. Azure App Service → Configuration → Application settings, usando
  // "__" como separador de jerarquia: ConnectionStrings__Default, Jwt__Key, etc.).
  // Este archivo solo cubre overrides de produccion que no son secretos.

  "IaService": {
    // URL interna del servicio de inferencia desplegado (no expuesto a internet).
    "BaseUrl": "CHANGEME-url-interna-del-servicio-ia"
  },
  "Cors": {
    // Dominio real del frontend desplegado. Sin esto, el navegador bloqueara
    // las llamadas del frontend en produccion (CORS).
    "AllowedOrigins": ["https://CHANGEME.azurewebsites.net"]
  }
}
